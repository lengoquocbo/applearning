<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">



    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Deck Selection with improved UI -->
            <TextView
                android:id="@+id/tvDeckLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bộ thẻ"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#212121"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deckSelectorCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:layout_constraintTop_toBottomOf="@id/tvDeckLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnNewDeck"
                app:layout_constraintWidth_percent="0.8">

                <Spinner
                    android:id="@+id/spinnerDeck"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:padding="8dp"
                    android:background="@android:color/transparent" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewDeck"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add_class"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="8dp"
                android:backgroundTint="#4285F4"
                android:contentDescription="Tạo bộ thẻ mới"
                app:layout_constraintTop_toTopOf="@id/deckSelectorCard"
                app:layout_constraintBottom_toBottomOf="@id/deckSelectorCard"
                app:layout_constraintStart_toEndOf="@id/deckSelectorCard"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Enhanced Card Preview with flip animation -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreview"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/deckSelectorCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ViewFlipper
                    android:id="@+id/cardFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Front side preview with better styling -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mattruoc_flashcard"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvFrontIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MẶT TRƯỚC"
                            android:textSize="12sp"
                            android:textColor="#78909C"
                            android:alpha="0.7"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tvCardFrontPreview"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#212121"
                            android:text="Xem trước mặt trước"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <ImageView
                            android:id="@+id/ivFrontImagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:visibility="gone"
                            android:contentDescription="Hình ảnh mặt trước"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Back side preview with better styling -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_matsau_flashcard"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBackIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MẶT SAU"
                            android:textSize="12sp"
                            android:textColor="#78909C"
                            android:alpha="0.7"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tvCardBackPreview"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif"
                            android:textColor="#212121"
                            android:text="Xem trước mặt sau"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <ImageView
                            android:id="@+id/ivBackImagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:visibility="gone"
                            android:contentDescription="Hình ảnh mặt trước"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </ViewFlipper>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modern Flip Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlipCard"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Lật thẻ"
                android:background="@drawable/bg_primary_button"
                android:layout_marginTop="12dp"
                app:icon="@drawable/ic_flip"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="24dp"
                android:backgroundTint="#5C6BC0"
                app:layout_constraintTop_toBottomOf="@id/cardPreview"
                app:layout_constraintEnd_toEndOf="parent" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLayoutContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#4285F4"
                app:layout_constraintTop_toBottomOf="@id/btnFlipCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/bg_secondary_button">

                <!-- Sử dụng một ConstraintLayout duy nhất để chứa tất cả các thành phần -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutMasterContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Front Side Input with better styling -->
                    <TextView
                        android:id="@+id/tvFrontLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mặt trước"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#212121"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFront"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="#4285F4"
                        app:hintTextColor="#4285F4"
                        app:layout_constraintTop_toBottomOf="@id/tvFrontLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFront"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:fontFamily="sans-serif"
                            android:textSize="16sp"
                            android:gravity="top|start"
                            android:padding="12dp"
                            android:hint="Nhập nội dung mặt trước..." />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Styled Media Buttons -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFrontMedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E0E0"
                        app:layout_constraintTop_toBottomOf="@id/tilFront"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:id="@+id/layoutFrontMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageButton
                                android:id="@+id/btnAddImage"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Thêm hình ảnh"
                                android:padding="8dp"
                                android:src="@drawable/ic_image"
                                tools:ignore="TouchTargetSizeCheck" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:id="@+id/divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="#E0E0E0"
                        app:layout_constraintTop_toBottomOf="@id/cardFrontMedia"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Back Side Input with better styling -->
                    <TextView
                        android:id="@+id/tvBackLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mặt sau"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#212121"
                        app:layout_constraintTop_toBottomOf="@id/divider"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="#4285F4"
                        app:hintTextColor="#4285F4"
                        app:layout_constraintTop_toBottomOf="@id/tvBackLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:fontFamily="sans-serif"
                            android:textSize="16sp"
                            android:gravity="top|start"
                            android:padding="12dp"
                            android:hint="Nhập nội dung mặt sau..." />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Styled Back Media Buttons -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBackMedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E0E0"
                        app:layout_constraintTop_toBottomOf="@id/tilBack"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:id="@+id/layoutBackMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageButton
                                android:id="@+id/btnBackAddImage"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_image"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Thêm hình ảnh"
                                android:padding="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Thêm divider thứ hai để phân tách với phần tags -->
                    <View
                        android:id="@+id/divider2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="#E0E0E0"
                        app:layout_constraintTop_toBottomOf="@id/cardBackMedia"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Tags Label -->
                    <TextView
                        android:id="@+id/tvTagsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Từ khóa"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#212121"
                        app:layout_constraintTop_toBottomOf="@id/divider2"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Enhanced Tags Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTags"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="#4285F4"
                        app:hintTextColor="#4285F4"
                        app:endIconDrawable="@drawable/ic_tag"
                        app:startIconTint="#4285F4"
                        app:layout_constraintTop_toBottomOf="@id/tvTagsLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:padding="12dp"
                            android:fontFamily="sans-serif"
                            android:hint="Thêm từ khóa (ngăn cách bằng dấu phẩy)" />
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Modernized Action Buttons -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardLayoutContent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMore"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Lưu và thêm thẻ mới"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Lưu thẻ"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="8dp"
                    android:backgroundTint="#4285F4"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Enhanced FAB -->
