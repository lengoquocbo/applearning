<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@android:color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tải tài liệu lên"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Attachments RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_attachments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="40dp"
        android:background="@drawable/border_dashed" />

    <!-- Add Attachment Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_attachment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm tài liệu đính kèm"
        app:icon="@drawable/ic_file"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_submission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi"
            app:backgroundTint="@color/colorPrimary" />
    </LinearLayout>

</LinearLayout>